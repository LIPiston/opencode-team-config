{
  "$schema": "https://opencode.ai/config.json",
  "model": "lipiston/deepseek-v4.1-flash",
  "small_model": "lipiston/deepseek-v4.1-flash",
  "enabled_providers": [
    "lipiston"
  ],
  "provider": {
    "lipiston": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LIPiston",
      "options": {
        "baseURL": "https://your-gateway.example.com/v1",
        "apiKey": "{env:LIPISTON_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "limit": {
            "context": 275000,
            "output": 32000
          }
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "limit": {
            "context": 275000,
            "output": 32000
          }
        },
        "kimi-3.1-pro": {
          "name": "Kimi 3.1 Pro",
          "limit": {
            "context": 275000,
            "output": 32000
          }
        },
        "glm-5.3": {
          "name": "GLM-5.3",
          "limit": {
            "context": 275000,
            "output": 32000
          }
        }
      }
    }
  },
  "plugins": [
    "__RYUGI_PLUGIN_DIR__",
    {
      "package": "@tarquinen/opencode-dcp@latest"
    },
    {
      "package": "@upstash/context7-opencode@latest"
    }
  ],
  "default_agent": "orchestrator",
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    }
  ],
  "experimental": {
    "todo": true,
    "artifacts": true,
    "schedules": true,
    "background_compaction": true
  },
  "providers": {
    "lipiston": {
      "name": "LIPiston",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://your-gateway.example.com/v1",
        "apiKey": "{env:LIPISTON_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "limit": {
            "context": 275000,
            "output": 32000
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "effort": [
                "none",
                "low",
                "medium",
                "high",
                "max"
              ]
            }
          }
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "limit": {
            "context": 275000,
            "output": 32000
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "effort": [
                "none",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          }
        },
        "kimi-3.1-pro": {
          "name": "Kimi 3.1 Pro",
          "limit": {
            "context": 275000,
            "output": 32000
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "effort": [
                "low",
                "medium",
                "high",
                "max"
              ]
            }
          }
        },
        "glm-5.3": {
          "name": "GLM-5.3",
          "limit": {
            "context": 275000,
            "output": 32000
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "effort": [
                "none",
                "low",
                "medium",
                "high",
                "max"
              ]
            }
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 30000
    }
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 32768
  }
}
